  <LuaScript>-- CheatLab Auto-Attach Script
local process = "spiderman.exe"
local function checkGame()
  if getOpenedProcessID() == 0 then
    openProcess(process)
  end
end
local t = createTimer(nil)
timer_setInterval(t, 2000)
timer_onTimer(t, checkGame)
